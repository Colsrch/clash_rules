######### 锚点 start #######
# 策略组相关
pr: &pr {type: select, proxies: [默认, 香港, 香港自动选择, 台湾, 台湾自动选择, 日本, 日本自动选择, 新加坡, 新加坡自动选择, 韩国, 韩国自动选择, 美国, 美国自动选择, 其它地区, 全部节点, 自动选择, 直连]}
pr_ai: &pr_ai {type: select, proxies: [默认, 日本, 日本自动选择, 美国, 美国自动选择, AI优化, OpenAI自动选择, 台湾, 台湾自动选择, 新加坡, 新加坡自动选择, 韩国, 韩国自动选择]}

#这里是订阅更新和延迟测试相关的
p: &p {type: http, interval: 3600, exclude-filter: "流量|重置|到期|过期|最新|福利|更新|超时|重启|订阅", health-check: {enable: true, url: "https://www.gstatic.com/generate_204", interval: 300}}
######### 锚点 end #######
# url 里填写自己的订阅,名称不能重复
# proxy-providers:
#   example:
#     <<: *p
#     url: "http://example.com"

# MetaCubeX Geo 数据
geodata-mode: true
geodata-loader: memconservative
geo-auto-update: true
geo-update-interval: 24

geox-url:
  geoip: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat"
  geosite: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"
  mmdb: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/country.mmdb"
  asn: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/GeoLite2-ASN.mmdb"

ipv6: false
allow-lan: false
profile:
  store-selected: true
  store-fake-ip: true
dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 28.0.0.1/8
  fake-ip-filter:
    - "*"
    - "+.lan"
    - "+.local"
  default-nameserver:
    - 223.5.5.5

proxies:
  - name: "直连"
    type: direct
    udp: true

proxy-groups:
- {name: 默认, type: select, proxies: [自动选择, 直连, 香港, 香港自动选择, 台湾, 台湾自动选择, 日本, 日本自动选择, 新加坡, 新加坡自动选择, 韩国, 韩国自动选择, 美国, 美国自动选择, 其它地区, 全部节点], icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Proxy.png"}
- {name: Anthropic, <<: *pr_ai, icon: "https://raw.githubusercontent.com/Koolson/Qure/refs/heads/master/IconSet/mini/AIA.png"}
- {name: OpenAI, type: select, include-all: true, proxies: [OpenAI自动选择], exclude-filter: "(?i)直连|港|hk|hongkong|hong kong", url: "https://chatgpt.com/backend-api/codex/responses", interval: 300, icon: "https://raw.githubusercontent.com/Koolson/Qure/refs/heads/master/IconSet/mini/AIA.png"}
- {name: SaaS, <<: *pr, icon: "https://raw.githubusercontent.com/Koolson/Qure/refs/heads/master/IconSet/mini/AIA.png"}
- {name: Google, <<: *pr, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Google_Search.png"}
- {name: GoogleCloud, <<: *pr_ai, icon: "https://raw.githubusercontent.com/Koolson/Qure/refs/heads/master/IconSet/Dark/GCP.png"}
- {name: Apple, <<: *pr, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Apple.png"}
- {name: Telegram, <<: *pr, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Telegram.png"}
- {name: Twitter, <<: *pr, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Twitter.png"}
- {name: ehentai, <<: *pr, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Panda.png"}
- {name: 哔哩哔哩, <<: *pr, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/bilibili.png"}
- {name: 哔哩东南亚, <<: *pr, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/bilibili.png"}
- {name: 巴哈姆特, <<: *pr, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Bahamut.png"}
- {name: YouTube, <<: *pr, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/YouTube.png"}
- {name: NETFLIX, <<: *pr, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Netflix.png"}
- {name: Spotify, <<: *pr, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Spotify.png"}
- {name: 国内, type: select, proxies: [直连, 默认, 香港, 香港自动选择, 台湾, 台湾自动选择, 日本, 日本自动选择, 新加坡, 新加坡自动选择, 韩国, 韩国自动选择, 美国, 美国自动选择, 其它地区, 全部节点, 自动选择], icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/China_Map.png"}
- {name: 其他, <<: *pr, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Final.png"}
  #分隔,下面是地区分组
- {name: 香港, type: select, include-all: true, filter: "(?i)(?!直连)(港|hk|hongkong|hong kong)", icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/HK.png"}
- {name: 台湾, type: select, include-all: true, filter: "(?i)(?!直连)(台|tw|taiwan)", icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/TW.png"}
- {name: 日本, type: select, include-all: true, filter: "(?i)(?!直连|jp-1|JP-1)(日|jp|japan)", icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/JP.png"}
- {name: 美国, type: select, include-all: true, filter: "(?i)(?!直连)(?!.*(?:openai|chatgpt|gpt))(美|us|unitedstates|united states)", icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/US.png"}
- {name: 新加坡, type: select, include-all: true, filter: "(?i)(?!直连)(新|sg|singapore)", icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/SG.png"}
- {name: 韩国, type: select, include-all: true, filter: "(?i)(?!直连)(韩|kr|southkorea)", icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/KR.png"}
- {name: 其它地区, type: select, include-all: true, filter: "(?i)^(?!.*(?:🇭🇰|🇯🇵|🇺🇸|🇸🇬|🇨🇳|港|hk|hongkong|台|tw|taiwan|日|jp|japan|新|sg|singapore|韩|kr|southkorea|美|us|unitedstates|直连)).*", icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Available.png"}
- {name: 自动选择, type: url-test, include-all: true, exclude-filter: "(?i)直连", tolerance: 10, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Auto.png"}
- {name: 全部节点, type: select, include-all: true, icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/Global.png"}
- {name: AI优化, type: select, include-all: true, filter: "(?i)(?!直连)(openai|chatgpt|gpt|gemini)", icon: "https://raw.githubusercontent.com/Koolson/Qure/refs/heads/master/IconSet/mini/AIA.png"}

- {name: 香港自动选择,type: url-test, include-all: true, filter: "(?i)(?!直连)(?!.*(?:倍))(港|hk|hongkong|hong kong)", icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/HK.png"}
- {name: 台湾自动选择,type: url-test, include-all: true, filter: "(?i)(?!直连)(台|tw|taiwan)", icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/TW.png"}
- {name: 日本自动选择,type: url-test, include-all: true, filter: "(?i)(?!直连|jp-1|JP-1)(日|jp|japan)", icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/JP.png"}
- {name: 美国自动选择,type: url-test, include-all: true, filter: "(?i)(?!直连)(?!.*(?:openai|chatgpt|gpt))(美|us|unitedstates|united states)", icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/US.png"}
- {name: 新加坡自动选择,type: url-test, include-all: true, filter: "(?i)(新|sg|singapore)", icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/SG.png"}
- {name: 韩国自动选择, type: url-test, include-all: true, filter: "(?i)(?!直连)(韩|kr|southkorea)", icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/mini/KR.png"}
- {name: OpenAI自动选择, type: url-test, include-all: true, exclude-filter: "(?i)直连|港|hk|hongkong|hong kong", url: "https://chatgpt.com/backend-api/codex/responses", interval: 300, icon: "https://raw.githubusercontent.com/Koolson/Qure/refs/heads/master/IconSet/mini/AIA.png"}

rules:
  # Cutto
  - RULE-SET,saas_direct_classical,直连
  - RULE-SET,saas_proxy_classical,SaaS

  # 本地程序、私有域名
  - RULE-SET,applications_cr,直连
  - RULE-SET,private_cr,直连
  - GEOSITE,private,直连

  # 广告拦截（保留 reject_cr 为主要规则，GEOSITE 作为补充）
  - RULE-SET,reject_cr,REJECT
  - GEOSITE,category-ads-all,REJECT

  # Apple 与中国区直连服务（这些必须放在 proxy_cr 和 geolocation-!cn 前面）
  - RULE-SET,icloud_cr,Apple
  - RULE-SET,apple_cr,Apple
  - GEOSITE,apple-cn,Apple

  # 明确需要国内线路的服务（“国内”组默认选择“直连”，行为与现在相同）
  - GEOSITE,onedrive,国内
  - GEOSITE,microsoft@cn,国内
  - GEOSITE,steam@cn,国内
  - GEOSITE,category-games@cn,国内

  # AI 服务（具体服务必须放在 category-ai-!cn 前面）
  - GEOSITE,anthropic,Anthropic
  - GEOSITE,openai,OpenAI
  - GEOSITE,google-gemini,GoogleCloud
  - GEOSITE,google-deepmind,GoogleCloud
  - GEOSITE,firebase,GoogleCloud
  - GEOSITE,googlefcm,GoogleCloud
  - RULE-SET,openai_classical,OpenAI
  - RULE-SET,claude_classical,Anthropic
  - RULE-SET,kiro_classical,Anthropic
  # 其他境外 AI/SaaS
  - GEOSITE,category-ai-!cn,SaaS

  # Google 和 YouTube
  # YouTube 必须放在 google_cr 前面，防止先进入 Google
  # ==================================================
  - GEOSITE,youtube,YouTube
  - RULE-SET,google_cr,Google
  - GEOSITE,google,Google

  # 通讯和社交
  # ==================================================
  - GEOSITE,telegram,Telegram
  - GEOSITE,twitter,Twitter

  # 视频、音乐和社区
  # ==================================================
  - GEOSITE,ehentai,ehentai
  - GEOSITE,bilibili,哔哩哔哩
  - GEOSITE,biliintl,哔哩东南亚
  - GEOSITE,bahamut,巴哈姆特
  - GEOSITE,netflix,NETFLIX
  - GEOSITE,spotify,Spotify

  # 没有专用组的常用境外服务
  # ==================================================
  - GEOSITE,github,默认
  - GEOSITE,pixiv,默认
  - GEOSITE,tiktok,默认
  - GEOSITE,category-scholar-!cn,默认

  # 现有广义域名规则
  # ==================================================
  - RULE-SET,proxy_cr,默认
  - RULE-SET,direct_cr,直连

  # GeoSite 广义兜底
  # ==================================================
  - GEOSITE,geolocation-!cn,默认
  - GEOSITE,cn,国内

  # IP 规则
  # GEOIP,LAN 已移除
  # ==================================================
  - RULE-SET,lancidr_cr,直连
  - RULE-SET,telegramcidr_cr,Telegram
  - RULE-SET,cncidr_cr,国内

  - MATCH, 其他

